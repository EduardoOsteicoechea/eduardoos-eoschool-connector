# Production site, or local Go API: http://127.0.0.1:8081
EDUARDOOS_BASE_URL=https://eduardoos.com
# Required for all /api/v1/homescool/* calls (docs command does not need a key).
# Create the key in eduardoos.com (Profile → API keys) — do NOT put it in
# eduardoos.com/backend/.env. Entitlements required: api + homescool.
EDUARDOOS_API_KEY=
